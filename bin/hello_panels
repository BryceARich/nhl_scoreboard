#!/usr/bin/env ruby
# frozen_string_literal: true

# Draws "hello" on the panels for ten seconds: the acceptance check for C1-01. Run it on the Pi as
# root, since the library needs GPIO access. docs/RESUME.md has the setup and the wiring.
#
#   sudo "$(mise which ruby)" bin/hello_panels ~/rpi-rgb-led-matrix/fonts/7x13.bdf

require_relative "../lib/nhl_scoreboard"

font_path = ARGV.fetch(0) { abort "usage: bin/hello_panels path/to/font.bdf" }

font = NhlScoreboard::Font.load(font_path)
begin
  NhlScoreboard::Matrix.open do |matrix|
    canvas = matrix.offscreen_canvas
    canvas.fill(0, 0, 0)
    y = (canvas.height - font.height) / 2 + font.baseline
    canvas.draw_text(font, 10, y, 255, 255, 255, "hello")
    matrix.swap_on_vsync(canvas)
    puts "showing hello on #{canvas.width}x#{canvas.height} for 10 seconds"
    sleep 10
  end
ensure
  font.close
end
