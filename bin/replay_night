#!/usr/bin/env ruby
# frozen_string_literal: true

# Plays a night of recorded games through the scoreboard's main loop, on the fake panels (the Mac
# stand-in). Each game is a recording in the directory: a .jsonl file from GameRecording, or a .json
# play-by-play payload, which PlayByPlay turns into a recording. The games start on one clock, from
# their recorded times, so the boards show the night as a live loop would have. Needs no panels,
# librgbmatrix or root. docs/RESUME.md has the commands.
#
# A layout is a number of boards (--panels, each the width of a 64-column panel) and how many per
# row (--columns). Give lists to try several layouts: every panel count is paired with every column
# count that fits it, so --panels 2,4 --columns 1,2 gives 2x1, 2x2 and 4x1, 4x2. Without --columns a
# layout is one row. --png writes one frame per layout, at --at seconds into the night; --serve
# plays the layouts in turn in a browser, each for --hold seconds at real speed.
#
#   bin/replay_night path/to/font.bdf games/2026-11-25 --panels 2 --serve 8080
#   bin/replay_night path/to/font.bdf games/2026-11-25 --panels 2,4,6 --columns 1,2,3 --png night.png --at 2400
#   bin/replay_night path/to/font.bdf games/2026-11-25 --panels 4,6 --columns 2,3 --serve 8080 --hold 60
#   bin/replay_night path/to/font.bdf games/2026-11-25 --panels 12 --columns 4 --pace events --serve 8080
#
# The favorite team comes from --favorite or $NHL_FAVORITE_TEAM, as in bin/scoreboard.
#
# --pace events steps each game one play at a time, the way a feed hands plays over, so the whole
# day plays in a few minutes; all games start together. --step sets the seconds between plays
# (default 1), with --pace events only. The default, --pace game, runs at game-clock
# speed from each game's start time. --at counts plays with --pace events, and seconds otherwise.

require "json"
require "optparse"
require "zlib"
require_relative "../lib/nhl_scoreboard"

# Draws each board list through a display and publishes the frame to the browser, so the main loop
# can draw through it without knowing about the server.
class BrowserDisplay
  def initialize(display, server, scale)
    @display = display
    @server = server
    @scale = scale
  end

  # Draws the boards and publishes the frame. A frame that fails to encode (Zlib::DataError, seen
  # on a thread under load) is retried once and then skipped, so one bad frame doesn't stop the
  # preview: the next tick draws the next frame.
  #
  # @param boards [Array<GameState>] the games on the boards.
  # @param step [Integer] the goal ticker's scroll step, from the main loop.
  # @return [void]
  def show(boards, step: 0)
    canvas = @display.show(boards, step: step)
    publish(canvas)
    nil
  end

  private

  # @param canvas [FakeCanvas] the frame to publish.
  # @return [void]
  def publish(canvas)
    @server.publish(canvas, scale: @scale)
  rescue Zlib::DataError => e
    $stderr.puts "replay_night: frame failed to encode (#{e.message}); retrying once"
    begin
      @server.publish(canvas, scale: @scale)
    rescue Zlib::DataError => e2
      $stderr.puts "replay_night: frame skipped (#{e2.message})"
    end
  end
end

# @param text [String] a comma-separated list of positive integers, such as "2,4".
# @return [Array<Integer>] the numbers, in the order given.
# @raise [ArgumentError] if an item isn't a positive integer.
def parse_list(text, name)
  text.split(",").map do |item|
    n = Integer(item, exception: false)
    raise ArgumentError, "#{name} must be positive integers, got #{item.inspect}" unless n&.positive?

    n
  end
end

options = {panels: [2], favorite: ENV["NHL_FAVORITE_TEAM"], dwell: NhlScoreboard::GamePicker::DEFAULT_DWELL, hold: 60}
parser = OptionParser.new do |opts|
  opts.banner = "usage: bin/replay_night path/to/font.bdf RECORDINGS_DIR [options]"
  opts.on("--panels LIST", "boards on the panels, such as 2 or 2,4,6 (default 2)") { |s| options[:panels] = s }
  opts.on("--columns LIST", "boards per row, such as 1 or 1,2,3 (default: all on one row)") { |s| options[:columns] = s }
  opts.on("--pace NAME", %w[game events], "game (default: game-clock speed from each start time) or events (one play a second)") { |name| options[:pace] = name.to_sym }
  opts.on("--step SECONDS", Float, "with --pace events, the seconds between plays (default 1)") { |s| options[:step] = s }
  opts.on("--favorite TRI", "favorite team's code, such as COL; its game takes the first board while it plays (default $NHL_FAVORITE_TEAM)") { |tri| options[:favorite] = tri }
  opts.on("--dwell SECONDS", Float, "seconds each game holds its board in the rotation (default #{NhlScoreboard::GamePicker::DEFAULT_DWELL})") { |s| options[:dwell] = s }
  opts.on("--serve PORT", Integer, "play the layouts in a browser at real speed, at http://127.0.0.1:PORT until Ctrl-C") { |port| options[:serve] = port }
  opts.on("--hold SECONDS", Float, "with --serve, seconds each layout plays before the next (default 60)") { |s| options[:hold] = s }
  opts.on("--hardware", "play on the real panels, one layout sized to them, as bin/scoreboard does (run as root on the Pi)") { options[:hardware] = true }
  opts.on("--png FILE", "write one frame per layout as a PNG instead of playing") { |file| options[:png] = file }
  opts.on("--at SECONDS", Float, "with --png, the frame this many seconds into the night (default 0)") { |s| options[:at] = s }
  opts.on("--from-period N", Integer, "with --serve and --favorite, start the night when the favorite's game reaches period N, such as 2") { |n| options[:from_period] = n }
end
parser.parse!

font_path, directory = ARGV.fetch(0) { abort parser.banner }, ARGV.fetch(1) { abort parser.banner }
abort "give --serve PORT, --png FILE or --hardware" unless options[:serve] || options[:png] || options[:hardware]
abort "--hardware plays on the real panels; don't combine it with --serve or --png" if options[:hardware] && (options[:serve] || options[:png])
abort "--at needs --png" if options[:at] && !options[:png]
abort "--hold needs --serve" if options[:hold] != 60 && !options[:serve]
pace = options[:pace] || :game
abort "--step needs --pace events" if options[:step] && pace != :events
step = options[:step] || 1

layouts = begin
  panel_counts = parse_list(options[:panels], "--panels")
  column_counts = options[:columns] ? parse_list(options[:columns], "--columns") : nil
  panel_counts.flat_map do |panels|
    (column_counts || [panels]).select { |columns| columns <= panels }.map { |columns| [panels, columns] }
  end
rescue ArgumentError => e
  abort e.message
end
abort "no layout fits: each column count must be at most its panel count" if layouts.empty?

paths = Dir.glob(File.join(directory, "*.{jsonl,json}")).sort
abort "no recordings (.jsonl) or play-by-play (.json) in #{directory}" if paths.empty?

games = begin
  paths.map do |path|
    if path.end_with?(".jsonl")
      NhlScoreboard::GameRecording.read(path)
    else
      NhlScoreboard::PlayByPlay.snapshots(JSON.parse(File.read(path)), pace: pace, step: step)
    end
  end
rescue NhlScoreboard::Error, JSON::ParserError, Errno::ENOENT => e
  abort e.message
end
night = begin
  NhlScoreboard::NightReplay.new(games)
rescue NhlScoreboard::Error => e
  abort e.message
end

logos = NhlScoreboard::LogoLibrary.load

# --from-period: the night starts when the favorite's game reaches that period, so every game
# starts from the same moment. Games that started earlier show their state at that moment.
offset = 0.0
if options[:from_period]
  abort "--from-period needs --serve and a favorite (--favorite or $NHL_FAVORITE_TEAM)" unless options[:serve] && options[:favorite]
  offset = night.seconds_into_period(options[:favorite].upcase, options[:from_period]) ||
    abort("#{options[:favorite].upcase} never reaches period #{options[:from_period]} in these games")
end

if options[:hardware]
  # The real panels: one layout, sized to them, with the same loop as the fake panels. Run as root.
  abort "--hardware needs one layout; give one --panels and one --columns" unless layouts.size == 1
  panels, columns = layouts.first
  grid = NhlScoreboard::BoardGrid.new(boards: panels, columns: columns)
  settings = NhlScoreboard::MatrixSettings.new
  canvas_width = settings.cols * settings.chain_length
  abort "a #{grid.width}x#{grid.height} grid doesn't fit the #{canvas_width}x#{settings.rows} panels" unless grid.width <= canvas_width && grid.height <= settings.rows

  font = NhlScoreboard::Font.load(font_path)
  begin
    NhlScoreboard::Matrix.open(settings) do |matrix|
      display = NhlScoreboard::GameDisplay.new(matrix, NhlScoreboard::ScoreboardLayout.new(font), logos,
        ticker: NhlScoreboard::GoalTicker.new(font, favorite: options[:favorite]), grid: grid)
      started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      elapsed = -> { Process.clock_gettime(Process::CLOCK_MONOTONIC) - started }
      NhlScoreboard::MainLoop.new(
        source: -> { night.states_at(elapsed.call) },
        display: display,
        picker: NhlScoreboard::GamePicker.new(favorite: options[:favorite], dwell: options[:dwell], board_count: grid.boards),
        poll_interval: ->(_game) { 1 },
        clock: elapsed
      ).run
    end
  ensure
    font.close
  end
  exit
end

font = NhlScoreboard::BdfFont.load(font_path)

# Builds the main loop's parts for one layout: the grid, the fake panels sized to it, the display and
# the picker. The loop itself is made by {build_loop}.
build_layout = lambda do |panels, columns|
  grid = NhlScoreboard::BoardGrid.new(boards: panels, columns: columns)
  settings = NhlScoreboard::MatrixSettings.new(rows: grid.height, cols: grid.width, chain_length: 1)
  matrix = NhlScoreboard::FakeMatrix.new(settings)
  display = NhlScoreboard::GameDisplay.new(matrix, NhlScoreboard::ScoreboardLayout.new(font), logos,
    ticker: NhlScoreboard::GoalTicker.new(font, favorite: options[:favorite]), grid: grid)
  picker = NhlScoreboard::GamePicker.new(favorite: options[:favorite], dwell: options[:dwell], board_count: grid.boards)
  [display, picker]
end

if options[:png]
  # One frame per layout, as the loop would draw it at that second of the night.
  at = options[:at] || 0.0
  base = options[:png].delete_suffix(".png")
  written = layouts.map do |panels, columns|
    display, picker = build_layout.call(panels, columns)
    canvas = display.show(picker.boards(night.states_at(at), now: at))
    file = (layouts.size == 1) ? options[:png] : "#{base}-#{panels}x#{columns}.png"
    File.binwrite(file, canvas.to_png(scale: 1))
    "#{file} (#{panels} boards, #{columns} per row)"
  end
  puts "wrote #{written.join(", ")} at #{at}s, #{night.size} games"
else
  scale = 7
  first_display, first_picker = build_layout.call(*layouts.first)
  server = NhlScoreboard::PreviewServer.new(port: options[:serve])
  server.publish(first_display.show(first_picker.boards(night.states_at(offset), now: offset)), scale: scale)
  listener = server.listen
  Thread.new do
    # Each layout plays the night from its start for --hold seconds, then the next, forever.
    loop do
      layouts.each do |panels, columns|
        display, picker = build_layout.call(panels, columns)
        started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
        real = -> { Process.clock_gettime(Process::CLOCK_MONOTONIC) - started }
        night_time = -> { offset + real.call }
        loop_ = NhlScoreboard::MainLoop.new(
          source: -> { night.states_at(night_time.call) },
          display: BrowserDisplay.new(display, server, scale),
          picker: picker,
          poll_interval: ->(_game) { 1 },
          clock: night_time
        )
        while real.call < options[:hold]
          sleep(loop_.tick(night_time.call))
        end
      end
    end
  end
  puts "playing #{night.size} games in #{layouts.size} #{(layouts.size == 1) ? "layout" : "layouts"} at http://127.0.0.1:#{server.port} (Ctrl-C to stop)"
  server.serve(listener)
end
