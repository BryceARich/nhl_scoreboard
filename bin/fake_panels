#!/usr/bin/env ruby
# frozen_string_literal: true

# Draws on the fake panels, the Mac stand-in for the real matrix. It needs no panels, librgbmatrix
# or root. Without --serve it prints the frame in the terminal (and can write a PNG). With --serve
# it shows the frame in a browser. docs/RESUME.md has the commands.
#
# --frame scoreboard draws a game state (--state, a JSON file; default assets/demo_game.json). A
# demo (--demo) plays that state out over time in the browser: countdown counts the clock down,
# home-logos cycles the home team through every logo. ticker scrolls the latest goal across the
# band under the boards, in the scoring team's colours, across every board.
#
#   bin/fake_panels path/to/font.bdf
#   bin/fake_panels path/to/font.bdf --png preview.png --scale 8
#   bin/fake_panels path/to/font.bdf --cols 64 --chain 1 --frame scoreboard --serve 8080
#   bin/fake_panels path/to/font.bdf --cols 64 --chain 1 --frame scoreboard --state my_game.json --serve 8080
#   bin/fake_panels path/to/font.bdf --cols 64 --chain 1 --frame scoreboard --serve 8080 --demo countdown
#   bin/fake_panels path/to/font.bdf --cols 64 --chain 1 --frame scoreboard --serve 8080 --demo home-logos

require "optparse"
require_relative "../lib/nhl_scoreboard"

DEFAULT_STATE = File.expand_path("../assets/demo_game.json", __dir__)

# Each demo turns the state into a sequence of states, by name.
DEMOS = {
  "countdown" => NhlScoreboard::GameSequence.method(:countdown),
  "home-logos" => NhlScoreboard::GameSequence.method(:cycle_home_logos)
}.freeze
# The ticker demo scrolls the latest goal instead (see the serve block), so it isn't in DEMOS.
DEMO_NAMES = (DEMOS.keys + ["ticker"]).freeze

options = {rows: 32, cols: 32, chain: 4, frame: "hello"}
parser = OptionParser.new do |opts|
  opts.banner = "usage: bin/fake_panels path/to/font.bdf [options]"
  opts.on("--rows N", Integer, "rows per panel (default 32)") { |n| options[:rows] = n }
  opts.on("--cols N", Integer, "columns per unit (default 32; 64 for a 64-wide panel)") { |n| options[:cols] = n }
  opts.on("--chain N", Integer, "units daisy-chained (default 4: 4 x 32 = 128 wide)") { |n| options[:chain] = n }
  opts.on("--png FILE", "also write the frame as a PNG") { |file| options[:png] = file }
  opts.on("--scale N", Integer, "PNG pixel size, e.g. 8 for big readable pixels (default 1)") { |n| options[:scale] = n }
  opts.on("--frame NAME", %w[hello scoreboard], "hello (default) or scoreboard, the game-state layout") { |name| options[:frame] = name }
  opts.on("--state FILE", "game state as JSON for --frame scoreboard (default #{DEFAULT_STATE})") { |file| options[:state] = file }
  opts.on("--demo NAME", DEMO_NAMES, "play the state out in the browser: #{DEMO_NAMES.join(", ")} (needs --serve and --frame scoreboard)") { |name| options[:demo] = name }
  opts.on("--serve PORT", Integer, "show the frame in a browser at http://127.0.0.1:PORT until Ctrl-C") { |port| options[:serve] = port }
end
parser.parse!

font_path = ARGV.fetch(0) { abort parser.banner }

if options[:demo] && !(options[:serve] && options[:frame] == "scoreboard")
  abort "--demo needs --serve and --frame scoreboard"
end
if options[:state] && options[:frame] != "scoreboard"
  abort "--state needs --frame scoreboard"
end

font = NhlScoreboard::BdfFont.load(font_path)
settings = NhlScoreboard::MatrixSettings.new(rows: options[:rows], cols: options[:cols], chain_length: options[:chain])
matrix = NhlScoreboard::FakeMatrix.new(settings)

if options[:frame] == "scoreboard"
  begin
    state = NhlScoreboard::GameState.load(options[:state] || DEFAULT_STATE)
  rescue NhlScoreboard::Error, Errno::ENOENT => e
    abort e.message
  end
  ticker = NhlScoreboard::GoalTicker.new(font)
  display = NhlScoreboard::GameDisplay.new(matrix, NhlScoreboard::ScoreboardLayout.new(font), NhlScoreboard::LogoLibrary.load, ticker: ticker)
  # A canvas 128 columns wide holds two boards, so the second board shows a second game.
  second = state.with(home_team: NhlScoreboard::GameState::Team.new(tri_code: "VGK", score: 2),
    away_team: NhlScoreboard::GameState::Team.new(tri_code: "CHI", score: 1), clock: "07:45", goals: [])
  boards = (matrix.offscreen_canvas.width >= 2 * NhlScoreboard::ScoreboardLayout::BOARD_WIDTH) ? [state, second] : [state]
  others = boards.drop(1)
  canvas = display.show(boards)
else
  canvas = matrix.offscreen_canvas
  canvas.fill(0, 0, 0)
  canvas.draw_text(font, 10, (canvas.height - font.height) / 2 + font.baseline, 255, 255, 255, "hello")
  matrix.swap_on_vsync(canvas)
  canvas = matrix.canvas
end

if options[:serve]
  # The browser page redraws from the PNG, so it defaults to 7 pixels per LED to fit a screen.
  scale = options[:scale] || 7
  server = NhlScoreboard::PreviewServer.new(port: options[:serve])
  server.publish(canvas, scale: scale)
  listener = server.listen

  if options[:demo] == "ticker"
    # The goal scrolls one column every tenth of a second, forever, across every board's band. The
    # thread runs until the process stops.
    Thread.new do
      (0..).each do |step|
        sleep 0.1
        server.publish(display.show(boards, step: step), scale: scale)
      end
    end
  elsif options[:demo]
    # Each state in the demo is shown for one second. The thread runs until the process stops.
    frames = DEMOS.fetch(options[:demo]).call(state)
    Thread.new do
      frames.each do |frame|
        sleep 1
        server.publish(display.show([frame, *others]), scale: scale)
      end
    end
  end

  puts "showing the frame at http://127.0.0.1:#{server.port} (Ctrl-C to stop)"
  server.serve(listener)
else
  puts canvas.to_terminal
  File.binwrite(options[:png], canvas.to_png(scale: options[:scale] || 1)) if options[:png]
end
